    function drawLine(el,vals){const w=600,h=180,p=24,min=Math.min(...vals),max=Math.max(...vals),range=Math.max(1,max-min);const pts=vals.map((v,i)=>{const x=vals.length===1?w/2:p+i*(w-2*p)/(vals.length-1);const y=h-p-(v-min)*(h-2*p)/range;return [x,y]});const path=pts.map((pnt,i)=>(i?'L':'M')+pnt[0].toFixed(1)+','+pnt[1].toFixed(1)).join(' ');el.innerHTML=`<svg viewBox="0 0 ${w} ${h}" role="img" aria-label="Gráfico de evolução"><path d="M24 ${h-p} H${w-p}" stroke="#29313d" fill="none"/><path d="${path}" stroke="#8fd3ff" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>${pts.map(pnt=>`<circle cx="${pnt[0]}" cy="${pnt[1]}" r="4" fill="#d7ff5f"/>`).join('')}<text x="24" y="18" fill="#98a2b3" font-size="11">${max.toFixed(1)}</text><text x="24" y="${h-5}" fill="#98a2b3" font-size="11">${min.toFixed(1)}</text></svg>`}

