    function renderCheckpoints(){const cps=[...state.checkpoints].sort((a,b)=>a.date.localeCompare(b.date)),last=cps[cps.length-1],first=cps[0];document.getElementById('cWeight').textContent=last&&last.weight?last.weight.toFixed(1)+' kg':'—';document.getElementById('cWaist').textContent=last&&last.waist?last.waist.toFixed(1)+' cm':'—';document.getElementById('cDelta').textContent=last&&first&&last.weight!=null&&first.weight!=null?((last.weight-first.weight)>=0?'+':'')+(last.weight-first.weight).toFixed(1)+' kg':'—';const weights=cps.filter(c=>c.weight!=null).map(c=>c.weight);if(weights.length)drawLine(document.getElementById('weightChart'),weights);else document.getElementById('weightChart').innerHTML='<div class="empty" style="margin:14px">Registre seu primeiro peso.</div>';const h=document.getElementById('checkpointHistory');h.innerHTML=cps.length?[...cps].reverse().map(c=>`<div class="historyItem"><div class="date">${fmtDate(c.date)}</div><div class="historyMain"><b>${c.weight!=null?c.weight.toFixed(1)+' kg':'Checkpoint'}</b><span>${c.waist!=null?'Cintura '+c.waist.toFixed(1)+' cm':''}${c.notes?' • '+esc(c.notes):''}</span></div><span class="tag">${c.energy?'energia '+c.energy+'/5':'•'}</span></div>`).join(''):'<div class="empty">Nenhum checkpoint registrado.</div>';}

