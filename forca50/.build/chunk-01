<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#0e1116" />
  <meta name="description" content="Treino 5x por semana — força e estética, com histórico e progressão." />
  <title>Força 50 — Treino & Evolução</title>
  <link rel="manifest" href="manifest.webmanifest" />
  <link rel="icon" href="icon.svg" type="image/svg+xml" />
  <style>
    :root{
      --bg:#0e1116;--panel:#151a22;--panel2:#1b222c;--line:#29313d;--text:#f5f7fa;--muted:#98a2b3;
      --accent:#d7ff5f;--accent2:#8fd3ff;--danger:#ff7b7b;--ok:#8de1a7;--radius:18px;
    }
    *{box-sizing:border-box} html{scroll-behavior:smooth} body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}
    button,input,select,textarea{font:inherit} button{cursor:pointer}
    .app{max-width:960px;margin:auto;padding:18px 16px 110px}
    .top{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:18px}
    .brand{font-weight:900;letter-spacing:-.03em;font-size:22px}.brand span{color:var(--accent)}
    .sub{font-size:12px;color:var(--muted);margin-top:2px}
    .pill{border:1px solid var(--line);background:var(--panel);color:var(--muted);padding:8px 11px;border-radius:999px;font-size:12px}
    .hero{padding:22px;border-radius:24px;background:linear-gradient(145deg,#171d26,#11151b);border:1px solid var(--line);margin-bottom:16px}
    .eyebrow{font-size:12px;color:var(--accent);font-weight:800;text-transform:uppercase;letter-spacing:.12em}
    h1{font-size:30px;line-height:1.02;margin:8px 0 12px;letter-spacing:-.04em} h2{font-size:20px;margin:0 0 12px} h3{font-size:16px;margin:0}
    .hero p{margin:0;color:var(--muted);line-height:1.5}
    .heroActions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
    .btn{border:0;border-radius:13px;padding:12px 15px;font-weight:850;min-height:44px}
    .btn.primary{background:var(--accent);color:#10130b}.btn.secondary{background:var(--panel2);color:var(--text);border:1px solid var(--line)}.btn.danger{background:#2a1719;color:#ffb1b1;border:1px solid #4a2428}
    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:12px 0 16px}.metric{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:14px;min-width:0}
    .metric b{display:block;font-size:24px;letter-spacing:-.03em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.metric span{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
    .section{margin:24px 0}.sectionHead{display:flex;justify-content:space-between;align-items:end;gap:12px;margin-bottom:11px}.sectionHead p{margin:0;color:var(--muted);font-size:13px}
    .cards{display:grid;gap:10px}.workoutCard,.card{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:16px}
    .workoutCard{display:flex;justify-content:space-between;gap:12px;align-items:center}.workoutCard.active{border-color:#617423;background:#171d15}.workoutMeta{color:var(--muted);font-size:12px;margin-top:5px}.tag{font-size:11px;padding:6px 8px;border-radius:999px;background:var(--panel2);color:var(--muted);white-space:nowrap}.tag.home{color:#bfe9ff}.tag.gym{color:#e9ff9e}
    .exercise{border-top:1px solid var(--line);padding-top:14px;margin-top:14px}.exercise:first-child{border-top:0;padding-top:0;margin-top:0}
    .exTop{display:flex;justify-content:space-between;gap:10px;align-items:start}.exName{font-weight:850}.exTarget{font-size:12px;color:var(--muted);margin-top:3px}.historyHint{font-size:11px;color:var(--accent2);margin-top:5px}
    .sets{margin-top:10px;display:grid;gap:8px}.setRow{display:grid;grid-template-columns:38px 1fr 1fr 72px 42px;gap:7px;align-items:center}.setNo{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:var(--panel2);color:var(--muted);font-size:12px;font-weight:800}
    .field{width:100%;min-width:0;background:#0f141a;border:1px solid var(--line);color:var(--text);padding:10px 9px;border-radius:11px;min-height:42px}.done{accent-color:var(--accent);width:20px;height:20px}.smallLabel{font-size:10px;color:var(--muted);display:block;margin-bottom:4px}
    .formGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.formGrid.two{grid-template-columns:repeat(2,1fr)} .full{grid-column:1/-1}
    .empty{padding:22px;text-align:center;border:1px dashed var(--line);border-radius:16px;color:var(--muted)}
    .historyItem{display:grid;grid-template-columns:90px 1fr auto;gap:12px;align-items:center;padding:11px 0;border-bottom:1px solid var(--line)}.historyItem:last-child{border-bottom:0}.date{font-size:12px;color:var(--muted)}.historyMain b{display:block}.historyMain span{font-size:12px;color:var(--muted)}
    .chart{width:100%;height:180px;background:#10151b;border-radius:14px;border:1px solid var(--line);overflow:hidden}.chart svg{width:100%;height:100%;display:block}.chartLabel{font-size:12px;color:var(--muted);margin:0 0 8px}
    .nav{position:fixed;left:50%;transform:translateX(-50%);bottom:14px;width:min(94%,720px);display:grid;grid-template-columns:repeat(5,1fr);gap:4px;padding:7px;background:rgba(20,25,33,.96);backdrop-filter:blur(14px);border:1px solid var(--line);border-radius:18px;z-index:50}.nav button{border:0;background:transparent;color:var(--muted);padding:9px 4px;border-radius:12px;font-size:10px;font-weight:700;min-width:0}.nav button.active{background:var(--accent);color:#11150c}.nav .ico{display:block;font-size:17px;margin-bottom:3px}
    .view{display:none}.view.active{display:block}.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.spacer{flex:1}.notice{padding:12px 14px;border-radius:13px;background:#18201a;border:1px solid #314329;color:#cfe6c3;font-size:13px;margin:10px 0}.warn{background:#241b15;border-color:#46301f;color:#f0c7a7}
    .progressList{display:grid;gap:10px}.progressRow{display:grid;grid-template-columns:minmax(130px,1fr) 88px 88px;gap:8px;align-items:center}.progressRow span{font-size:12px;color:var(--muted)}
    .modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.62);z-index:80;padding:18px;align-items:flex-end;justify-content:center}.modal.open{display:flex}.sheet{width:min(100%,720px);max-height:88%;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:22px;padding:18px}.sheetTop{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:12px}.iconBtn{border:1px solid var(--line);background:var(--panel2);color:var(--text);width:42px;height:42px;border-radius:12px}
    .checklist{display:grid;gap:8px}.checkItem{display:flex;align-items:center;gap:10px;background:#10151b;border:1px solid var(--line);border-radius:12px;padding:10px}.checkItem input{width:20px;height:20px;accent-color:var(--accent)}
    @media(max-width:640px){.grid{grid-template-columns:repeat(3,1fr)}.metric{padding:12px 10px}.metric b{font-size:20px}.setRow{grid-template-columns:32px 1fr 1fr 62px 34px;gap:5px}.formGrid,.formGrid.two{grid-template-columns:1fr 1fr}.workoutCard{align-items:flex-start}.progressRow{grid-template-columns:1fr 72px 72px}.app{padding-left:12px;padding-right:12px}.hero{padding:18px}h1{font-size:27px}}
    @media(max-width:390px){.grid{grid-template-columns:1fr 1fr}.grid .metric:last-child{grid-column:1/-1}.formGrid,.formGrid.two{grid-template-columns:1fr}.setRow{grid-template-columns:30px 1fr 1fr 55px 32px}.setNo{width:30px;height:30px}}
  </style>
</head>
<body>
  <main class="app" id="app">
    <div class="top">
      <div><div class="brand">FORÇA <span>50</span></div><div class="sub">Força • estética • progressão</div></div>
      <div class="pill" id="memoryStatus">Memória local ativa</div>
    </div>

    <section class="view active" data-view="home">
      <div class="hero">
        <div class="eyebrow" id="todayLabel">Treino de hoje</div>
        <h1 id="today