function days(){return [...(S.plan.days||[])].sort((a,b)=>a.sort_order-b.sort_order)}
function exFor(code){return (S.plan.exercises||[]).filter(x=>x.workout_code===code).sort((a,b)=>a.sort_order-b.sort_order)}
function subsFor(key){return (S.plan.substitutes||[]).filter(x=>x.exercise_key===key).sort((a,b)=>a.sort_order-b.sort_order)}
function todayPlan(){
  const dow=new Date().getDay(), exact=days().find(x=>x.day_of_week===dow);if(exact)return{day:exact,isToday:true};
  let best=null,delta=99;for(const d of days()){let x=(d.day_of_week-dow+7)%7;if(x===0)x=7;if(x<delta){delta=x;best=d}}return{day:best,isToday:false,delta}
}
function sessionsOn(date){return S.sessions.filter(s=>s.performed_at===date)}
function weekMonday(d=new Date()){const x=new Date(d);const wd=(x.getDay()+6)%7;x.setDate(x.getDate()-wd);x.setHours(0,0,0,0);return x}
function currentWeek(){const m=weekMonday();return Array.from({length:7},(_,i)=>{const x=new Date(m);x.setDate(m.getDate()+i);return x})}
function volumeSession(s){return(s.sets||[]).reduce((a,x)=>a+(Number(x.weight_kg)||0)*(Number(x.reps)||0),0)}
function totalVolume(){return S.sessions.reduce((a,s)=>a+volumeSession(s),0)}
function lastSet(exKey){
  const ordered=[...S.sessions].sort((a,b)=>b.performed_at.localeCompare(a.performed_at)||String(b.created_at||'').localeCompare(String(a.created_at||'')));
  for(const s of ordered){const arr=(s.sets||[]).filter(x=>x.exercise_key===exKey&&Number(x.reps)>0);if(arr.length){const best=[...arr].sort((a,b)=>Number(b.weight_kg)-Number(a.weight_kg)||Number(b.reps)-Number(a.reps))[0];return{session:s,set:best,sets:arr}}}return null
}
function progression(ex){
  const l=lastSet(ex.exercise_key);if(!l)return'Primeiro registro: escolha uma carga com RIR 1–2.';
  const top=Math.max(...l.sets.map(x=>Number(x.weight_kg)||0));const same=l.sets.filter(x=>(Number(x.weight_kg)||0)===top);
  const hit=same.length>=Math.min(ex.sets_target,l.sets.length)&&same.every(x=>Number(x.reps)>=ex.reps_max);
  return `Último: ${top||'peso corporal'}${top?' kg':''} • ${hit&&top?`meta batida → tente ${(top+2.5).toFixed(1)} kg`:'repita a carga e busque mais reps'}`;
}
