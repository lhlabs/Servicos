        if(error)throw error;s.cloudId=row.id;
        const {error:delErr}=await cloud.from('forca50_sets').delete().eq('user_id',uid).eq('session_id',row.id);if(delErr)throw delErr;
        const rows=[];(s.exercises||[]).forEach(ex=>(ex.sets||[]).forEach((st,i)=>rows.push({user_id:uid,session_id:row.id,exercise_key:ex.id,exercise_name:ex.name||getExerciseName(ex.id),set_number:i+1,weight_kg:Number(st.weight)||0,reps:Math.max(0,Math.floor(Number(st.reps)||0)),rir:st.rir==null?null:Number(st.rir),completed:Boolean(st.done)})));
        if(rows.length){const {error:setErr}=await cloud.from('forca50_sets').insert(rows);if(setErr)throw setErr}
      }
      for(const c of state.checkpoints){
        const payload={user_id:uid,client_ref:c.clientRef,measured_at:c.date||localDateISO(),weight_kg:c.weight??null,waist_cm:c.waist??null,chest_cm:c.chest??null,arm_cm:c.arm??null,thigh_cm:c.thigh??null,body_fat_pct:c.bodyfat??null,sleep_quality:c.sleep??null,energy:c.energy??null,notes:c.notes||null};
        const {error}=await cloud.from('forca50_checkpoints').upsert(payload,{onConflict:'user_id,client_ref'});if(error)throw error;
