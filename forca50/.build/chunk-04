otstrap(deviceId,deviceSecret,claim=''){
  const r=await fetch(API,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({action:'bootstrap',device_id:deviceId,device_secret:deviceSecret,claim}),cache:'no-store'});
  const j=await r.json().catch(()=>({ok:false,error:'response_invalid'}));if(!r.ok||!j.ok)throw new Error(j.error||'activation_failed');return j
}
async function initDevice(){
  $('activation').hidden=false;
  let d=loadJSON(DEVICE_KEY,null), claim=new URLSearchParams(location.search).get('claim')||'';
  if(d?.deviceId&&d?.secret){
    try{await bootstrap(d.deviceId,d.secret);D=d;$('activation').hidden=true;$('shell').hidden=false;return true}catch(e){if(String(e.message)!=='device_denied'){D=d;$('activation').hidden=true;$('shell').hidden=false;return true}}
  }
  if(!claim){
    $('activationTitle').textContent='Este aparelho precisa ser ativado';
    $('activationText').textContent='Abra o link de ativação do Força 50 neste navegador. Não há login ou senha.';
    $('activationMsg').innerHTML='<div class="notice warning">A ativação é feita uma única vez e fica salva neste navegador.</div>';
    return false
  }
  try{
    const nd={deviceId:uuid(),secret:secret()};await bootstrap(nd.deviceId,nd.secret,claim);localStorage.setItem(DEVICE_KEY,JSON.stringify(nd));D=nd;
    const u=new URL(location.href);u.searchParams.delete('claim');history.replaceState({},'',u.pathname+(u.searchParams.toString()?'?'+u.searchParams:''));
    $('activation').hidden=true;$('shell').hidden=false;return true
  }catch(e){
    $('activationTitle').textContent='Não foi possível ativar';
    $('activationText').textContent='O link de ativação pode ter expirado ou já ter sido usado.';
    $('activationMsg').innerHTML=`<div class="notice error">Código: ${esc(e.message)}</div>`;return false
  }
}
async function refreshState(show=true){
  if(show)setCloud('','sincronizando');
  try{const j=await call('state');S={plan:j.plan,sessions:j.sessions||[],checkpoints:j.checkpoints||[]};saveCache();setCloud('ok','banco online');renderAll();return true}
  catch(e){const c=loadJSON(CACHE_KEY,null);if(c){S=c;setCloud('off','modo offline');renderAll()}else setCloud('off','sem conexão');return false}
}
async function queueOrSend(action,payload){
  try{await call(action,payload);setCloud('ok','salvo na nuvem');return true}
  catch(e){const q=qload();q.push({id:uuid(),action,payload,at:new Date().toISOString()});qsave(q);setCloud('off','salvo no aparelho');return false}
}
async function flushQueue(){
  let q=qload();if(!q.length)return;
  const keep=[];for(const x of q){try{await call(x.action,x.payload)}catch{keep.push(x)}}qsave(keep);if(keep.length===0)await refreshState(false)
}
window.addEventListener('online',()=>{flushQueue().catch(()=>{});refreshState(false).catch(()=>{})});

