    }
    async function pullCloud(){
      if(!authUser||!cloud)return;
      const uid=authUser.id;
      const {data:ss,error:sErr}=await cloud.from('forca50_sessions').select('*').eq('user_id',uid).order('performed_at',{ascending:true});if(sErr)throw sErr;
      const ids=(ss||[]).map(x=>x.id);let setRows=[];
      if(ids.length){const {data,error}=await cloud.from('forca50_sets').select('*').eq('user_id',uid).in('session_id',ids).order('set_number',{ascending:true});if(error)throw error;setRows=data||[]}
      const bySession=new Map();setRows.forEach(r=>{if(!bySession.has(r.session_id))bySession.set(r.session_id,[]);bySession.get(r.session_id).push(r)});
      const remoteSessions=(ss||[]).map(r=>{
        const grouped=new Map();(bySession.get(r.id)||[]).forEach(st=>{if(!grouped.has(st.exercise_key))grouped.set(st.exercise_key,{id:st.exercise_key,name:st.exercise_name,sets:[]});grouped.get(st.exercise_key).sets.push({weight:Number(st.weight_kg)||0,reps:Number(st.reps)||0,rir:st.rir==null?0:Number(st.rir),done:Boolean(st.completed)})});
        return{id:r.client_ref||('cloud-'+r.id),clientRef:r.client_ref||('cloud-'+r.id),cloudId:r.id,date:r.performed_at,workoutId:r.workout_code,workoutName:r.workout_name,notes:r.notes||'',exercises:[...grouped.values()]};
      });
      const {data:cp,error:cErr}=await cloud.from('forca50_checkpoints').select('*').eq('user_id',uid).order('measured_at',{ascending:true});if(cErr)throw cErr;
      const remoteCps=(cp||[]).map(r=>({id:r.client_ref||('cloud-'+r.id),clientRef:r.client_ref||('cloud-'+r.id),cloudId:r.id,date:r.measured_at,weight:r.weight_kg==null?null:Number(r.weight_kg),waist:r.waist_cm==null?null:Number(r.waist_cm),chest:r.chest_cm==null?null:Number(r.chest_cm),arm:r.arm_cm==null?null:Number(r.arm_cm),thigh:r.thigh_cm==null?null:Number(r.thigh_cm),bodyfat:r.body_fat_pct==null?null:Number(r.body_fat_pct),sleep:r.sleep_quality==null?null:Number(r.sleep_quality),energy:r.energy==null?null:Number(r.energy),notes:r.notes||''}));
      const sm=new Map(state.sessions.map(s=>[s.clientRef||String(s.id),s]));remoteSessions.forEach(s=>sm.set(s.clientRef,s));state.sessions=[...sm.values()].sort((a,b)=>(a.date||'').localeCompare(b.date||''));
      const cm=new Map(state.checkpoints.map(c=>[c.clientRef||String(c.id),c]));remoteCps.forEach(c=>cm.set(c.clientRef,c));state.checkpoints=[...cm.values()].sort((a,b)=>(a.date||'').localeCompare(b.date||''));
      persistLocal();renderAll();
    }
