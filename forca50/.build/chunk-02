<body>
<div id="activation" class="activation card" hidden>
  <div class="eyebrow">Força 50 • dispositivo</div>
  <h1 id="activationTitle">Ativando…</h1>
  <p class="mut" id="activationText">Preparando a memória segura deste aparelho.</p>
  <div id="activationMsg"></div>
</div>

<div id="shell" hidden>
<main class="app">
  <header class="top">
    <div><div class="brand">FORÇA <b>50</b></div><div class="sub">treino • carga • presença • evolução</div></div>
    <div class="spacer"></div>
    <div class="cloud" id="cloud">conectando</div>
  </header>

  <section class="view on" id="todayView">
    <div class="hero">
      <div class="eyebrow" id="todayEyebrow">Treino de hoje</div>
      <h1 id="todayName">Carregando…</h1>
      <div class="mut" id="todayMeta"></div>
      <div class="actions">
        <button class="btn primary" id="startToday">Abrir treino</button>
        <button class="btn secondary" data-nav="progressView">Ver evolução</button>
      </div>
    </div>
    <div class="metrics">
      <div class="metric"><b id="mWeek">0/5</b><span>semana</span></div>
      <div class="metric"><b id="mAttendance">—</b><span>presença 8 sem.</span></div>
      <div class="metric"><b id="mSessions">0</b><span>treinos</span></div>
      <div class="metric"><b id="mVolume">0</b><span>kg registrados</span></div>
    </div>

    <div class="section">
      <div class="row"><h2>Treino</h2><div class="spacer"></div><select class="field" id="workoutSelect" style="max-width:330px"></select></div>
      <div class="cards" id="exerciseList"><div class="skeleton"></div></div>
    </div>
    <div class="section card" style="padding:14px">
      <label class="label">Notas do treino</label>
      <textarea class="field" id="workoutNotes" rows="3" placeholder="Como foi o treino?"></textarea>
      <div class="actions">
        <button class="btn primary" id="saveWorkout">Finalizar e salvar</button>
        <button class="btn ghost" id="clearWorkout">Limpar</button>
      </div>
      <div id="saveMsg" style="margin-top:10px"></div>
    </div>
  </section>

  <section class="view" id="weekView">
    <h2>Semana & presença</h2>
    <div class="mut">Cada dia planejado vira concluído, pendente ou falta automaticamente.</div>
    <div class="section cards" id="weekCards"></div>
    <div class="section card" style="padding:14px">
      <div class="row"><h3>Últimas 8 semanas</h3><div class="spacer"></div><span class="mut" id="attSummary"></span></div>
      <div class="attgrid" id="attendanceGrid" style="margin-top:12px"></div>
      <div class="legend">
        <span><i class="lg" style="background:#1d3c26"></i>treino</span>
        <span><i class="lg" style="background:#3a2022"></i>falta</span>
        <span><i class="lg" style="background:#323820"></i>hoje</span>
        <span><i class="lg" style="background:#121820"></i>descanso</span>
      </div>
    </div>
    <div class="section card" style="padding:14px">
      <h3>Histórico</h3><div id="sessionHistory"></div>
    </div>
  </section>

  <section class="view" id="progressView">
    <h2>Evolução</h2>
    <div class="metrics">
      <div class="metric"><b id="pSessions">0</b><span>sessões</span></div>
      <div class="metric"><b id="pAttendance">—</b><span>presença</span></div>