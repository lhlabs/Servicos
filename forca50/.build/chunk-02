rid;grid-template-columns:repeat(2,1fr);gap:9px}.full{grid-column:1/-1}.chart{height:190px;background:#0d1319;border:1px solid var(--line);border-radius:14px;overflow:hidden}.chart svg{width:100%;height:100%;display:block}.history{display:grid}.hist{display:grid;grid-template-columns:82px 1fr auto;gap:10px;align-items:center;padding:11px 0;border-bottom:1px solid var(--line)}.hist:last-child{border-bottom:0}.loadrow{display:grid;grid-template-columns:1fr auto auto;gap:10px;padding:10px 0;border-bottom:1px solid var(--line);align-items:center}.loadrow:last-child{border-bottom:0}
