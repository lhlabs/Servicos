    function openWorkout(id){currentWorkout=workouts.find(w=>w.id===id);if(!currentWorkout)return;document.getElementById('workoutPlace').textContent=currentWorkout.place.toUpperCase();document.getElementById('workoutTitle').textContent=currentWorkout.name;document.getElementById('workoutFocus').textContent=`${currentWorkout.focus} • ${currentWorkout.duration}`;document.getElementById('workoutNotes').value='';document.getElementById('saveMessage').innerHTML='';
