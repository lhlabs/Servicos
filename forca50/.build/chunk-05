    function closeWorkout(){document.getElementById('workoutModal').classList.remove('open')}
    document.getElementById('closeWorkout').onclick=closeWorkout;document.getElementById('cancelWorkout').onclick=closeWorkout;
    document.getElementById('finishWorkout').addEventListener('click',()=>{if(!currentWorkout)return;const rows=[...document.querySelectorAll('#workoutExercises .setRow')];const grouped={};rows.forEach(r=>{const ex=r.dataset.ex;if(!grouped[ex])grouped[ex]=[];const weight=Math.max(0,Number(r.querySelector('.weight').value)||0),reps=Math.max(0,Math.floor(Number(r.querySelector('.reps').value)||0)),rir=Math.max(0,Math.min(10,Number(r.querySelector('.rir').value)||0)),done=r.querySelector('.done').checked;if(reps>0||weight>0||done)grouped[ex].push({weight,reps,rir,done});});const exercises=currentWorkout.exercises.map(ex=>({id:ex.id,name:ex.name,sets:grouped[ex.id]||[]})).filter(e=>e.sets.length);if(!exercises.length){document.getElementById('saveMessage').innerHTML='<div class="notice warn">Registre pelo menos uma série antes de concluir.</div>';return;}const sid=Date.now();const session={id:sid,clientRef:'session-'+sid,date:localDateISO(),workoutId:currentWorkout.id,workoutName:currentWorkout.name,notes:document.getElementById('workoutNotes').value.trim(),exercises};state.sessions.push(session);save();document.getElementById('saveMessage').innerHTML='<div class="notice">Treino salvo. Histórico e recordes atualizados.</div>';setTimeout(()=>{closeWorkout();renderAll();navigate('home')},550);});

